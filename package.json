{
  "name": "porter-delivery-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/porter-web",
    "apps/customer-web",
    "apps/driver-web",
    "apps/admin-web",
    "packages/*",
    "services/api",
    "apps/customer-mobile",
    "apps/driver-mobile"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "npm run dev --workspace=apps/porter-web -- --port 5176 --strictPort",
    "dev:customer": "npm run dev --workspace=apps/customer-web",
    "dev:driver": "npm run dev --workspace=apps/driver-web",
    "dev:admin": "npm run dev --workspace=apps/admin-web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/e2e.mjs && node scripts/interventions.mjs && node scripts/smoke.mjs && node scripts/error-states.mjs && node scripts/forms.mjs",
    "dev:api": "node scripts/init-launch.mjs && node scripts/build-api.mjs && node --env-file=.env.launch services/api/dist/server.mjs",
    "test:launch": "node scripts/launch-check.mjs",
    "test:providers": "node --test tests/providers.test.mjs",
    "build:production": "npm run build --workspace=apps/customer-web && npm run build --workspace=apps/driver-web && npm run build --workspace=apps/admin-web && npm run build --workspace=services/api"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.21.5",
    "pg": "^8.23.1",
    "playwright": "^1.64.0",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.3.3",
    "vite": "^5.2.11"
  }
}