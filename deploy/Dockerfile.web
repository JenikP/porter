FROM node:22-bookworm-slim AS build
ARG APP=customer
WORKDIR /app
COPY . .
RUN npm ci && npm run build --workspace=apps/${APP}-web && cp -r apps/${APP}-web/dist /web-output
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web-output /usr/share/nginx/html
EXPOSE 80
