# Local: npm run dev:api creates .env.launch with a random manager password.
# Deployment: inject secrets through your hosting secret manager, never commit them.
NODE_ENV=production
API_HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgres://porter:REPLACE_WITH_SECRET@database:5432/porter
APP_ORIGINS=https://customer.example.test,https://driver.example.test,https://operations.example.test
BOOTSTRAP_ADMIN_EMAIL=REPLACE_WITH_MANAGER_EMAIL
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_SECRET
ALLOW_SIMULATORS=false
PAYMENT_PROVIDER=http
PAYMENT_URL=https://REPLACE_WITH_PAYMENT_GATEWAY
PAYMENT_TOKEN=REPLACE_WITH_SECRET
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_SECRET
ROUTING_PROVIDER=http
ROUTING_URL=https://REPLACE_WITH_ROUTE_GATEWAY
ADDRESS_SEARCH_URL=https://REPLACE_WITH_ADDRESS_GATEWAY
ROUTING_TOKEN=REPLACE_WITH_SECRET
NOTIFICATION_PROVIDER=http
NOTIFICATION_URL=https://REPLACE_WITH_NOTIFICATION_GATEWAY
NOTIFICATION_TOKEN=REPLACE_WITH_SECRET
# Enable only channels supported by your gateway. Empty means in-app only.
NOTIFICATION_CHANNELS=EMAIL,SMS,PUSH
# Native wrappers require explicit API origin and real-device cookie verification.
NATIVE_ORIGINS=capacitor://localhost,https://localhost
SESSION_CROSS_SITE=true
# Identity documents: private volume locally; HTTPS object-storage gateway in deployment.
DOCUMENT_STORAGE=local
DOCUMENT_STORAGE_PATH=/data/private-uploads
# DOCUMENT_STORAGE=http
# DOCUMENT_STORAGE_URL=https://your-private-object-storage-gateway
# DOCUMENT_STORAGE_TOKEN=REPLACE_WITH_SERVER_ONLY_SECRET
# PORTER_ENV=staging enforces simulator-only payments.
