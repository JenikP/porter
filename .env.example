NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/porter_dev
JWT_SECRET=change-this-in-production-use-env-var
JWT_EXPIRES_IN=7d

# Simulated external services (no real credentials required)
PAYMENT_PROVIDER=simulator
MAP_PROVIDER=simulator
SMS_PROVIDER=simulator
PUSH_PROVIDER=simulator
IDENTITY_PROVIDER=simulator

# App URLs
CUSTOMER_APP_URL=http://localhost:5173
DRIVER_APP_URL=http://localhost:5174
ADMIN_APP_URL=http://localhost:5175
API_URL=http://localhost:3001

# Upload settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
