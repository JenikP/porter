# New central launch API. Legacy JWT/Express scaffold is not mounted.
NODE_ENV=development
PORT=3001
SQLITE_PATH=.data/porter-launch.sqlite
APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
PAYMENT_PROVIDER=simulator
ROUTING_PROVIDER=simulator
NOTIFICATION_PROVIDER=simulator
# npm run dev creates a random administrator password in ignored .env.launch.
# For production provider/database templates, see services/api/.env.example.